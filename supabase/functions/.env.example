# Sekrety Edge Functions (ustawiane przez `supabase secrets set --env-file supabase/functions/.env`,
# NIGDY nie commitować prawdziwego pliku .env do repo).
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sa dostarczane
# automatycznie przez Supabase do kazdej Edge Function — nie trzeba ich tu dodawac.

# PayU (sklep PLN — Modul 6). Bez tych kluczy shop-checkout zwraca jawny stan
# "payment_configured:false" zamiast udawac udana platnosc.
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
